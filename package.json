{
  "name": "kvideo-cloud",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "KVideo Cloud — a liquid-glass video streaming portal on Cloudflare Workers with a strict HLS ad filter, memberships and points.",
  "license": "MIT",
  "author": "KVideo Cloud contributors",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "dev:local": "node scripts/dev-server.mjs",
    "build": "vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "import:sources": "node scripts/import-sources.mjs",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json",
    "db:migrate:local": "wrangler d1 migrations apply kvideo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kvideo-db --remote",
    "db:studio": "wrangler d1 execute kvideo-db --local --command \"select name from sqlite_master where type='table'\""
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "hono": "^4.13.13",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
